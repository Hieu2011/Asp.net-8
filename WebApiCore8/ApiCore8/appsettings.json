  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Graylog" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [],
    "EnableLogging": {
      "Console": true,
      "File": true,
      "Graylog": true
    },
    "Properties": {
      "Application": "WebApiNet8"
    },
    "Graylog": {
      "Hostname": "graylognet8.com",
      "Port": 12201,
      "TransportType": "Udp",
      "Facility": "HPM"
    }
  },

  "Logging": {
    "EnableFileLogging": true,
    "EnableGraylog": true,
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }

  },
  "ConnectionStrings": {
    "Postgres": "Server=192.168.48.162;Port=5432;Database=HPM;User ID=admin;Password=admin"
  },
  "AppSettings": {
    "MaxRetry": 5,
    "IsFeatureEnabled": true,
    "ApiBaseUrl": "https://api.example.com"
  },
  "AllowedHosts": "*"
}
