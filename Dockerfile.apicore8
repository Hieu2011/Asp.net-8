# Build context = root repo (Coolify: Base Directory = /)
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /repo

# Restore trước để tận dụng cache layer
COPY ["Directory.Build.props", "Directory.Packages.props", "./"]
COPY ["src/ApiCore8/ApiCore8.Api/ApiCore8.Api.csproj", "src/ApiCore8/ApiCore8.Api/"]
COPY ["src/ApiCore8/ApiCore8.Application/ApiCore8.Application.csproj", "src/ApiCore8/ApiCore8.Application/"]
COPY ["src/ApiCore8/ApiCore8.Infrastructure/ApiCore8.Infrastructure.csproj", "src/ApiCore8/ApiCore8.Infrastructure/"]
COPY ["src/ApiCore8/ApiCore8.Domain/ApiCore8.Domain.csproj", "src/ApiCore8/ApiCore8.Domain/"]
COPY ["src/Shared/Shared.Common/Shared.Common.csproj", "src/Shared/Shared.Common/"]
COPY ["src/Shared/Shared.DataAccess/Shared.DataAccess.csproj", "src/Shared/Shared.DataAccess/"]
COPY ["src/Shared/Shared.Caching/Shared.Caching.csproj", "src/Shared/Shared.Caching/"]
COPY ["src/Shared/Shared.Logging/Shared.Logging.csproj", "src/Shared/Shared.Logging/"]
RUN dotnet restore "src/ApiCore8/ApiCore8.Api/ApiCore8.Api.csproj"

COPY src/ApiCore8/ src/ApiCore8/
COPY src/Shared/ src/Shared/
RUN dotnet publish "src/ApiCore8/ApiCore8.Api/ApiCore8.Api.csproj" -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=build /app/publish ./
ENTRYPOINT ["dotnet", "ApiCore8.Api.dll"]
