{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Graylog", "Serilog.Sinks.MongoDB" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [],
    "EnableLogging": {
      "Console": true,
      "File": true,
      "Graylog": true,
      "Mongo": true
    },
    "Properties": {
      "Application": "WebApiNet8"
    },
    "Graylog": {
      "Hostname": "graylognet8.com",
      "Port": 12201,
      "TransportType": "Udp",
      "Facility": "HPM"
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  "ConnectionStrings": {
    "Database": "",
    "Postgres": "",
    "Oracle": "",
    "SqlServer": "",
    "MongoDB": "",
    "Redis": ""
  },

  "Database": {
    "MongoDatabase": "webapi_logs",
    "MongoCollection": "APILogs"
  },
  "AppSettings": {
    "MaxRetry": 5,
    "IsFeatureEnabled": true,
    "ApiBaseUrl": "https://api.example.com"
  },
  "AllowedHosts": "*",
  // ✅ NEW - Multi-layer DDoS Protection
  "AntiDDoS": {
    "Enabled": true,

    // LAYER 1: Connection Limiting
    "MaxConcurrentConnectionsPerIP": 10,
    "MaxConcurrentConnectionsGlobal": 1000,

    // LAYER 2: Token Bucket
    "TokenBucket": {
      "Capacity": 20,
      "RefillRate": 5,
      "RefillIntervalMs": 1000
    },

    // LAYER 3: Sliding Window (Multiple time windows)
    "RateLimits": [
      {
        "WindowSeconds": 1,
        "MaxRequests": 10,
        "Penalty": "Warning"
      },
      {
        "WindowSeconds": 10,
        "MaxRequests": 50,
        "Penalty": "Warning"
      },
      {
        "WindowSeconds": 60,
        "MaxRequests": 100,
        "Penalty": "TempBlock"
      }
    ],

    // LAYER 4: Progressive Blocking
    "BlockStrategy": {
      "FirstViolationSeconds": 60,
      "SecondViolationSeconds": 300,
      "ThirdViolationSeconds": 1800,
      "FourthViolationSeconds": 86400
    },

    // Endpoint-specific strict rules
    "EndpointRules": [
      {
        "Pattern": "/api/auth/login",
        "MaxRequestsPerMinute": 5
      },
      {
        "Pattern": "/api/auth/register",
        "MaxRequestsPerMinute": 2
      },
      {
        "Pattern": "/api/payment",
        "MaxRequestsPerMinute": 10
      }
    ],

    // Whitelist (bypass all checks)
    "WhitelistedIPs": [
      "127.0.0.1",
      "::1"
    ],

    // Blacklist (permanent ban)
    "BlacklistedIPs": []
  },
  // Redis configuration
  "Redis": {
    "EncryptionKey": ""
  }
}
