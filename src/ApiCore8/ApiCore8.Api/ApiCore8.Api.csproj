<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>271068b8-431d-4afe-8731-a9f8db287759</UserSecretsId>
    <DockerDefaultTargetOS>Windows</DockerDefaultTargetOS>
  </PropertyGroup>

  <!-- Image cho CI: dotnet publish -t:PublishContainer (không cần Dockerfile) -->
  <PropertyGroup>
    <ContainerRepository>hieu2011/apicore8</ContainerRepository>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:8.0</ContainerBaseImage>
    <!-- Giữ root như Dockerfile cũ vì Serilog đang ghi file vào /app/logs -->
    <ContainerUser>root</ContainerUser>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Properties\launchSettings.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Properties\launchSettings.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApiCore8.Application\ApiCore8.Application.csproj" />
    <ProjectReference Include="..\ApiCore8.Infrastructure\ApiCore8.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="logs\" />
  </ItemGroup>

</Project>
