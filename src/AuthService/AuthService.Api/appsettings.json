{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "EnableLogging": {
      "Console": true,
      "File": false,
      "Graylog": false,
      "Mongo": true
    },
    "Properties": {
      "Application": "AuthService"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": "",
    "MongoDB": ""
  },
  "Database": {
    "MongoDatabase": "webapi_logs",
    "MongoCollection": "AuthApiLogs",
    "SystemLogsCollection": "AuthSystemLogs"
  },
  "AllowedHosts": "*"
}
